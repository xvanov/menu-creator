{
    "name": "menu-creator",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "setup": "node scripts/setup.mjs",
        "deploy:gcp": "node scripts/deploy-gcp.mjs",
        "deploy:vercel": "node scripts/deploy-vercel.mjs",
        "dev": "next dev",
        "build": "next build",
        "vercel-build": "node scripts/vercel-build.mjs",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:push": "drizzle-kit push --force",
        "db:seed": "tsx scripts/seed.ts",
        "db:reset": "drizzle-kit push --force && tsx scripts/seed.ts --all"
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "drizzle-orm": "^0.45.3",
        "html-to-image": "^1.11.13",
        "next": "16.3.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "^0.0.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^24.19.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.3.6",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.0.2"
    }
}
