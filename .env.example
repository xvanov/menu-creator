# Copied to .env.local by `npm run setup`. All values are optional.

# AI provider. Leave empty for automatic: every provider with a key, as a fallback chain in the order
# anthropic → gemini → groq → openai (if one hits its quota or fails, the next is tried); with no keys,
# the Claude Code CLI on this computer (your Claude subscription). If nothing works the app shows a
# warning and everything still works without AI. Explicit: one name or a chain, e.g. "gemini,groq".
#   claude-cli | anthropic | gemini | groq | openai | none
LLM_PROVIDER=
# Groq has a free tier, no card (https://console.groq.com/keys) — good backup when Gemini's quota runs out.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# Any other OpenAI-compatible API (OpenRouter, Mistral, DeepSeek…):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Gemini has a free tier (https://aistudio.google.com/apikey). Free-tier prompts may be reviewed by Google.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=

# Database. Default is a local file. For the cloud: a Turso URL + token.
# DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Shared PIN to open the app (leave empty on a local computer)
# APP_PIN=

# Protects /api/cron/generate (Cloud Scheduler / Vercel Cron)
# CRON_SECRET=

# Set to 1 to stop the automatic 17:00 generation while the app runs locally
# DISABLE_MENU_SCHEDULER=1

# Set to 1 where the server gets no CPU after responding (Cloud Run request-based billing)
# BACKGROUND_INLINE=1
