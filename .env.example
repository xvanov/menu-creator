# Copied to .env.local by `npm run setup`. All values are optional.

# AI provider. Leave empty for automatic: ANTHROPIC_API_KEY if set, else GEMINI_API_KEY if set,
# else the Claude Code CLI on this computer (your Claude subscription, no key). If none works,
# the app shows a warning and everything still works without AI.
#   claude-cli | anthropic | gemini | none
LLM_PROVIDER=
# Gemini has a free tier (https://aistudio.google.com/apikey). Free-tier prompts may be reviewed by Google.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=

# Database. Default is a local file. For the cloud: a Turso URL + token.
# DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Shared PIN to open the app (leave empty on a local computer)
# APP_PIN=

# Protects /api/cron/generate (Cloud Scheduler / Vercel Cron)
# CRON_SECRET=

# Set to 1 to stop the automatic 17:00 generation while the app runs locally
# DISABLE_MENU_SCHEDULER=1

# Set to 1 where the server gets no CPU after responding (Cloud Run request-based billing)
# BACKGROUND_INLINE=1
